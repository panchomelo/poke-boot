# Variables del backend. Se exportan en el shell antes de ejecutar:
#   set -a; . ./.env; set +a
#   ./mvnw spring-boot:run

# Firma de los JWT (mínimo 32 caracteres). Obligatorio en producción.
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=120

# Administrador inicial. Solo se crea si todavía no existe ningún ADMIN.
APP_ADMIN_EMAIL=admin@ejemplo.com
APP_ADMIN_PASSWORD=una-clave-segura

# Conexión MySQL (coincide con docker-compose.yml).
DB_USERNAME=root
DB_PASSWORD=root
